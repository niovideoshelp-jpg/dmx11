{
  "name": "dmx11",
  "version": "1.0.0",
  "private": true,
  "description": "DN-XI intro — documentary motion graphics in Remotion",
  "scripts": {
    "dev": "remotion studio",
    "lottie": "node scripts/build-lottie.mjs",
    "map": "node scripts/build-map.mjs",
    "still": "remotion still src/index.ts Intro out/still.png",
    "render": "remotion render src/index.ts Intro out/dmx11-intro.mp4 --codec=h264 --crf=18",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "@remotion/google-fonts": "4.0.537",
    "@remotion/gsap": "4.0.537",
    "@remotion/lottie": "4.0.537",
    "@remotion/media": "4.0.537",
    "@remotion/paths": "4.0.537",
    "gsap": "3.15.0",
    "lottie-web": "5.13.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@fontsource/lato": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@types/react": "19.2.18",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "world-atlas": "2.0.2"
  }
}
